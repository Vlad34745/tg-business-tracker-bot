BOT_TOKEN=your_telegram_bot_token_here
SPREADSHEET_ID=your_google_sheet_id_here
# Comma-separated Telegram user IDs allowed to use the bot.
# The FIRST id in this list keeps using the original "Transactions"/
# "Budgets" tabs. Every other id gets its own isolated
# "Transactions_<id>"/"Budgets_<id>" tab, created automatically on
# their first entry — so multiple people can share one bot without
# seeing or deleting each other's data.
ALLOWED_USER_ID=123456789,987654321